{
  "extends": "./config/typescript/react-library",
  "include": ["src", "config", "*.js", "*.mjs", "*.ts", ".content-collections"],

  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": [
      "node",
      "vite/client",
      "./config/vite-plugins/buildinfo/types.d.ts",
      "./config/vite-plugins/link-previews/types.d.ts"
    ],
    "module": "ESNext",
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "allowJs": true,

    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    /* Linting */
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      "content-collections": ["./.content-collections/generated"]
    }
  }
}
